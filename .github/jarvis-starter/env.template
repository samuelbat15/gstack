OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 100% local via Ollama (teste et retenu apres comparaison de plusieurs
# modeles le 2026-07-12 : qwen2.5:7b est le seul a suivre correctement le
# protocole JSON de la boucle agentic. Les modeles plus petits (3b/1b) sont
# plus rapides mais choisissent le mauvais outil ou cassent le JSON.
# Compter 70-95s par tour sur CPU seul, pas de GPU utilise par le container.
JARVIS_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

JARVIS_DATA_DIR=./data

# Pour OpenRouter (cloud, modeles gratuits disponibles):
# JARVIS_PROVIDER=openrouter
# OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Chemin du vault Obsidian pour la memoire long terme (vide = valeur par
# defaut C:\Users\aiell\Documents\STARBOXE-Notes)
JARVIS_VAULT_PATH=

# Reconnaissance vocale locale (Whisper) - modele "base" par defaut, plus
# precis mais plus lent avec "small"/"medium". Aucune cle requise.
JARVIS_WHISPER_MODEL=base

# Vision webcam ponctuelle - modele Ollama vision (deja teste: moondream).
# Aucune cle requise, utilise OLLAMA_BASE_URL ci-dessus.
JARVIS_VISION_MODEL=moondream

# Synthese vocale ElevenLabs (optionnelle). Sans cle, Jarvis utilise pyttsx3
# (voix Windows SAPI, locale mais robotique). Genere une cle sur
# elevenlabs.io, choisis une voix sur elevenlabs.io/app/voice-library et
# copie son voice_id ici.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Backend HTTP (server.py). En local uniquement par defaut (127.0.0.1) -
# aucune cle requise. Pour un acces depuis un autre appareil (telephone),
# mets JARVIS_HOST=0.0.0.0 et genere un token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_API_TOKEN=

# Gmail (lecture seule) - OAuth, pas de cle API classique. Voir README
# section Gmail pour creer credentials.json (Google Cloud Console).
# Chemins par defaut : credentials.json / token.json a la racine du projet.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
