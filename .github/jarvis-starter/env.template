OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 100% local via Ollama (teste et retenu apres comparaison de plusieurs
# modeles le 2026-07-12 : qwen2.5:7b est le seul a suivre correctement le
# protocole JSON de la boucle agentic. Les modeles plus petits (3b/1b) sont
# plus rapides mais choisissent le mauvais outil ou cassent le JSON.
# Compter 70-95s par tour sur CPU seul, pas de GPU utilise par le container.
JARVIS_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

JARVIS_DATA_DIR=./data

# Pour OpenRouter (cloud, modeles gratuits disponibles):
# JARVIS_PROVIDER=openrouter
# OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Chemin du vault Obsidian pour la memoire long terme (vide = valeur par
# defaut C:\Users\aiell\Documents\STARBOXE-Notes)
JARVIS_VAULT_PATH=
